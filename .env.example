# Copy to .env and fill in what you use. Only key names here, never values.

# ---- host page ----
MCP_URL=            # default http://127.0.0.1:3301/mcp
SIM_PORT=           # default 8180
SANDBOX_PORT=       # default 8181
PRESETS_FILE=       # default presets.json
SKILL_FILE=         # default skills/SKILL.md (optional)

# ---- agent mode: any OpenAI-compatible endpoint, read only by the host server ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
